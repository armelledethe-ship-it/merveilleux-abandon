"<!-- wp:html -->\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500;1,700&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=DM+Sans:wght@400;500;700&display=swap\">\n<style>\n/* Layout : une page nuit, le portrait comme une couverture d\u00e9cal\u00e9e sur un aplat corail, le nom qui chevauche la photo, puis un sommaire de liens */\n .ma-liens{\n  --nuit:#14213d; --nuit-2:#1c2c4f; --papier:#ffffff; --creme:#fff4ee; --corail:#ef6f5e; --corail-fonce:#d9533f; --brume:rgba(255,255,255,.62); --filet:rgba(255,255,255,.16);\n  --titre:\"Playfair Display\",Georgia,serif; --texte:\"Fraunces\",Georgia,serif; --ui:\"DM Sans\",system-ui,sans-serif;\n  color-scheme:dark;font-family:var(--ui);background:var(--nuit);color:var(--papier);width:100vw;margin-left:calc(50% - 50vw);overflow-x:hidden;min-height:100vh;}\n.ma-liens *,.ma-liens *::before,.ma-liens *::after{box-sizing:border-box}\n\n\n\n.col{max-width:460px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}\n\n/* Couverture */\n.couv{position:relative;padding-block:28px 0}\n.haut{display:flex;justify-content:space-between;align-items:center;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--brume);margin-bottom:22px}\n.haut b{color:var(--corail);font-weight:700}\n.cadre{position:relative;margin-right:28px}\n.cadre::before{content:\"\";position:absolute;inset:22px -28px -22px 28px;background:var(--corail);border-radius:2px}\n.cadre img{position:relative;display:block;width:100%;aspect-ratio:760/825;object-fit:cover;filter:grayscale(1) contrast(1.05);border-radius:2px;animation:apparait 1.1s ease-out both}\n.vertical{position:absolute;right:-22px;top:50%;transform:translate(50%,-50%) rotate(90deg);white-space:nowrap;font:700 .72rem var(--ui);letter-spacing:.32em;color:var(--nuit);text-transform:uppercase}\n.credit{position:absolute;left:10px;bottom:10px;font-size:.62rem;letter-spacing:.04em;color:rgba(255,255,255,.75)}\nh1{position:relative;margin:-58px 0 0;font-family:var(--titre);font-weight:500;font-style:italic;font-size:clamp(3.2rem,15vw,4.4rem);line-height:.88;letter-spacing:-.01em}\nh1 span{display:block;font-style:normal;font-weight:700;color:var(--corail);padding-left:.9em}\n.bio{font-family:var(--texte);font-size:1.08rem;line-height:1.5;color:var(--brume);margin:22px 0 0;max-width:32ch}\n.bio strong{color:var(--papier);font-weight:600}\n\n/* Bandeau d\u00e9filant */\n.ruban{margin-top:30px;background:var(--corail);color:var(--nuit);overflow:hidden;transform:rotate(-2deg);width:110%;margin-left:-5%}\n.ruban div{display:flex;gap:28px;padding-block:10px;width:max-content;animation:defile 26s linear infinite;font:500 .95rem var(--texte);font-style:italic}\n.ruban i{font-style:normal;opacity:.55}\n\n/* Page offerte */\n.offerte{margin-top:42px;position:relative;display:block;width:100%;text-align:left;border:0;cursor:pointer;background:var(--creme);color:var(--nuit);padding:26px 22px 22px;border-radius:2px;transform:rotate(1.2deg);box-shadow:-10px 10px 0 var(--nuit-2);transition:transform .2s}\n.offerte:hover{transform:rotate(0)}\n.offerte:focus-visible{outline:3px solid var(--corail);outline-offset:4px}\n.offerte .coin{position:absolute;top:14px;right:16px;font:italic 600 .82rem var(--texte);color:var(--corail)}\n.offerte .eti{font:700 .66rem var(--ui);letter-spacing:.2em;text-transform:uppercase;color:var(--corail)}\n.offerte .t{display:block;margin-top:10px;font-family:var(--titre);font-size:1.7rem;line-height:1.1}\n.offerte .t em{color:var(--corail)}\n.offerte .s{display:block;margin-top:10px;font-family:var(--texte);font-size:.95rem;line-height:1.45;color:#4a5675}\n.offerte .go{display:inline-flex;margin-top:16px;align-items:center;gap:10px;font:700 .9rem var(--ui);background:var(--nuit);color:var(--papier);padding:12px 16px;border-radius:99px}\n.offerte .go::after{content:\"\u2192\";color:var(--corail)}\n\n/* Sommaire */\n.sommaire{margin-top:46px}\n.sommaire h2{font:700 .7rem var(--ui);letter-spacing:.22em;text-transform:uppercase;color:var(--brume);margin:0 0 6px;display:flex;align-items:center;gap:10px}\n.sommaire h2::after{content:\"\";flex:1;height:1px;background:var(--filet)}\n.ligne{position:relative;display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px;width:100%;padding:18px 2px;border:0;border-bottom:1px solid var(--filet);background:none;color:var(--papier);text-decoration:none;text-align:left;cursor:pointer;overflow:hidden}\n.ligne::before{content:\"\";position:absolute;inset:0;background:var(--corail);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;z-index:0}\n.ligne:hover::before,.ligne:focus-visible::before{transform:scaleX(1)}\n.ligne:focus-visible{outline:none}\n.ligne>*{position:relative;z-index:1}\n.ligne .eti{display:block;font:700 .64rem var(--ui);letter-spacing:.2em;text-transform:uppercase;color:var(--corail);transition:color .3s}\n.ligne .nom{display:block;margin-top:4px;font-family:var(--texte);font-size:1.25rem;line-height:1.2}\n.ligne .fl{width:38px;height:38px;border-radius:50%;border:1px solid var(--filet);display:grid;place-items:center;color:var(--corail);font-size:1.05rem;transition:all .3s}\n.ligne:hover .eti,.ligne:focus-visible .eti{color:var(--nuit)}\n.ligne:hover .nom,.ligne:focus-visible .nom{color:var(--nuit)}\n.ligne:hover .fl,.ligne:focus-visible .fl{background:var(--nuit);border-color:var(--nuit);transform:rotate(-45deg)}\n\n.reseaux{margin-top:34px;display:flex;flex-wrap:wrap;gap:10px}\n.reseaux a{flex:1 1 0;min-width:0;text-align:center;padding:12px 8px;border:1px solid var(--filet);border-radius:99px;color:var(--papier);text-decoration:none;font:500 .85rem var(--ui);transition:border-color .2s,color .2s}\n.reseaux a:hover{border-color:var(--corail);color:var(--corail)}\nfooter{padding-block:34px 44px;text-align:center;font-size:.72rem;letter-spacing:.06em;color:var(--brume);display:flex;flex-direction:column;gap:6px}\nfooter .sig{font-family:var(--titre);font-style:italic;font-size:1.3rem;letter-spacing:0;color:var(--papier)}\nfooter .sig em{color:var(--corail)}\n\n/* Feuilles */\n.voile{position:fixed;inset:0;background:rgba(8,14,30,.6);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity .25s;z-index:20}\n.voile.ouvert{opacity:1;pointer-events:auto}\n.feuille{position:fixed;left:0;right:0;bottom:0;z-index:21;max-width:480px;margin:0 auto;background:var(--creme);color:var(--nuit);border-radius:18px 18px 0 0;padding:20px max(22px,env(safe-area-inset-left,0px)) calc(26px + env(safe-area-inset-bottom,0px));transform:translateY(105%);transition:transform .35s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column;gap:14px;color-scheme:light}\n.feuille.ouvert{transform:none}\n.poignee{width:42px;height:4px;border-radius:2px;background:rgba(20,33,61,.18);align-self:center}\n.feuille .eti{font:700 .66rem var(--ui);letter-spacing:.2em;text-transform:uppercase;color:var(--corail)}\n.feuille h3{font-family:var(--titre);font-weight:500;font-size:1.6rem;line-height:1.1;margin:-6px 0 0}\n.feuille h3 em{color:var(--corail)}\n.feuille p{margin:0;font-family:var(--texte);line-height:1.5;color:#4a5675}\n.opts{display:flex;flex-direction:column;gap:8px}\n.opt{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 16px;background:var(--papier);border:1px solid rgba(20,33,61,.12);border-radius:10px;color:var(--nuit);text-decoration:none;font:500 1rem var(--ui);cursor:pointer;text-align:left;transition:border-color .2s,transform .2s}\n.opt:hover{border-color:var(--corail);transform:translateX(3px)}\n.opt:focus-visible{outline:3px solid var(--corail);outline-offset:2px}\n.opt small{display:block;font-weight:400;font-size:.8rem;color:#6a7591;margin-top:2px}\n.opt .f{color:var(--corail);flex:none}\ninput{font:1rem var(--ui);padding:15px 16px;border:1px solid rgba(20,33,61,.2);border-radius:10px;background:var(--papier);color:var(--nuit)}\ninput:focus-visible{outline:3px solid var(--corail);outline-offset:1px}\n.plein{justify-content:center;background:var(--corail);border-color:var(--corail);color:var(--papier);font-weight:700}\n.plein:hover{background:var(--corail-fonce)}\n.fermer{background:none;border:0;font:500 .9rem var(--ui);color:#6a7591;cursor:pointer;padding:6px;align-self:center}\n.merci{font-style:italic;color:var(--corail-fonce)!important}\n\n@keyframes defile{to{transform:translateX(-50%)}}\n@keyframes apparait{from{opacity:0;transform:scale(1.04)}to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\nbody:has(.ma-liens){background:#14213d!important}\nbody:has(.ma-liens) .wp-site-blocks>header,body:has(.ma-liens) .wp-site-blocks>footer,body:has(.ma-liens) .wp-block-post-title,body:has(.ma-liens) footer.wp-block-template-part,body:has(.ma-liens) header.wp-block-template-part{display:none!important}\nbody:has(.ma-liens) .wp-site-blocks,body:has(.ma-liens) main,body:has(.ma-liens) .entry-content,body:has(.ma-liens) .wp-block-post-content{padding:0!important;margin:0!important;max-width:none!important}\nbody:has(.ma-liens) .wp-site-blocks>*{margin-block-start:0!important}\n.ma-liens h1,.ma-liens h2,.ma-liens h3,.ma-liens p{max-width:none}\n.ma-liens .ma-nl{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;background:none}\n.ma-liens .ma-nl input[type=text],.ma-liens .ma-nl input[type=email]{font:1rem var(--ui);padding:15px 16px;border:1px solid rgba(20,33,61,.2);border-radius:10px;background:#fff;color:var(--nuit);width:100%}\n.ma-liens .ma-nl input[name=email_address_check]{position:absolute!important;left:-9999px!important}\n.ma-liens .ma-nl label{font:500 .8rem var(--ui);color:#4a5675}\n.ma-liens .ma-nl button{font:700 1rem var(--ui);padding:15px 16px;border:0;border-radius:10px;background:var(--corail);color:#fff;cursor:pointer}\n.ma-liens .ma-nl button:hover{background:var(--corail-fonce)}\n.ma-liens .ma-nl .ma-row{display:flex;gap:8px}.ma-liens .ma-nl .ma-row>*{flex:1;min-width:0}\n</style>\n<div class=\"ma-liens\">\n<main class=\"col\">\n  <section class=\"couv\">\n    <div class=\"haut\"><span>Autrice</span><b>Merveilleux Abandon</b></div>\n    <div class=\"cadre\">\n      <img src=\"https://merveilleuxabandon.fr/wp-content/uploads/2026/10/portrait-liens-armelle-de-the.jpg\" alt=\"Portrait d'Armelle de Th\u00e9, souriante, en veste en jean\" width=\"760\" height=\"825\">\n      <span class=\"vertical\">N\u00e9e sous X \u00b7 1967</span>\n      <span class=\"credit\">\u00a9 Sophie Thouvenin / prismes.com</span>\n    </div>\n    <h1>Armelle<span>de Th\u00e9</span></h1>\n    <p class=\"bio\">N\u00e9e sous X. <strong>Ce que l'abandon m'a offert</strong>, je l'ai \u00e9crit dans un livre. Et une question me suit partout : comment ne pas s'oublier en route ?</p>\n  </section>\n</main>\n<div class=\"ruban\" aria-hidden=\"true\"><div>\n  <span>Ce que l'abandon m'a offert</span><i>\u2726</i><span>Comment ne pas s'oublier en route ?</span><i>\u2726</i><span>Une seconde chance</span><i>\u2726</i>\n  <span>Ce que l'abandon m'a offert</span><i>\u2726</i><span>Comment ne pas s'oublier en route ?</span><i>\u2726</i><span>Une seconde chance</span><i>\u2726</i>\n</div></div>\n<main class=\"col\">\n  <button class=\"offerte\" type=\"button\" data-feuille=\"ml-pages\">\n    <span class=\"coin\">p. 1 \u2192 20</span>\n    <span class=\"eti\">Offert</span>\n    <span class=\"t\">Les 20 premi\u00e8res pages, <em>pour vous.</em></span>\n    <span class=\"s\">Commencez Merveilleux Abandon ce soir. Je vous les envoie par email.</span>\n    <span class=\"go\">Je les veux</span>\n  </button>\n  <nav class=\"sommaire\" aria-label=\"Liens\">\n    <h2>Sommaire</h2>\n    <button class=\"ligne\" type=\"button\" data-feuille=\"ml-livre\"><span><span class=\"eti\">Lire</span><span class=\"nom\">Commander le livre</span></span><span class=\"fl\">\u2192</span></button>\n    <a class=\"ligne\" href=\"/conferences/\"><span><span class=\"eti\">D\u00e9couvrir</span><span class=\"nom\">Ma conf\u00e9rence : Arr\u00eate de croire qu'on t'a abandonn\u00e9, tu t'es juste oubli\u00e9 en route</span></span><span class=\"fl\">\u2192</span></a>\n    <a class=\"ligne\" href=\"/ecouter/\"><span><span class=\"eti\">\u00c9couter</span><span class=\"nom\">Mes interviews radio, podcasts et vid\u00e9os</span></span><span class=\"fl\">\u2192</span></a>\n    <a class=\"ligne\" href=\"/registre/\"><span><span class=\"eti\">T\u00e9moigner</span><span class=\"nom\">Le registre des abandons</span></span><span class=\"fl\">\u2192</span></a>\n    <a class=\"ligne\" href=\"/\"><span><span class=\"eti\">Le site</span><span class=\"nom\">La blessure d'abandon racont\u00e9e par celle qui l'a v\u00e9cue</span></span><span class=\"fl\">\u2192</span></a>\n    <a class=\"ligne\" href=\"/presse/\"><span><span class=\"eti\">Presse</span><span class=\"nom\">Ils en parlent</span></span><span class=\"fl\">\u2192</span></a>\n    <button class=\"ligne\" type=\"button\" data-feuille=\"ml-contact\"><span><span class=\"eti\">\u00c9crire</span><span class=\"nom\">Me contacter</span></span><span class=\"fl\">\u2192</span></button>\n  </nav>\n  <div class=\"reseaux\">\n    <a href=\"https://www.instagram.com/armelledethe/\" target=\"_blank\" rel=\"noopener\">Instagram</a>\n    <a href=\"https://www.facebook.com/armelle.dethe/\" target=\"_blank\" rel=\"noopener\">Facebook</a>\n    <a href=\"https://www.linkedin.com/in/armelle-de-th%C3%A9-5a866b4/\" target=\"_blank\" rel=\"noopener\">LinkedIn</a>\n  </div>\n  <footer>\n    <span class=\"sig\">Merveilleux <em>Abandon</em></span>\n    <span>\u00c9ditions Jouvence \u00b7 288 pages</span>\n    <span><a href=\"/mentions-legales/\" style=\"color:inherit\">Mentions l\u00e9gales</a></span>\n  </footer>\n</main>\n<div class=\"voile\" id=\"ml-voile\"></div>\n<section class=\"feuille\" id=\"ml-pages\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ml-t-pages\">\n  <div class=\"poignee\"></div>\n  <span class=\"eti\">Offert</span>\n  <h3 id=\"ml-t-pages\">Les 20 premi\u00e8res pages <em>arrivent.</em></h3>\n  <p>Laissez votre email. Vous recevez les pages tout de suite, puis de mes nouvelles de temps en temps.</p>\n  <div id=\"ml-form\">__FORM__</div>\n  <p class=\"merci\" id=\"ml-merci\" hidden>Merci. Regardez votre bo\u00eete mail, les pages sont en route.</p>\n  <button class=\"fermer\" type=\"button\">Fermer</button>\n</section>\n<section class=\"feuille\" id=\"ml-livre\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ml-t-livre\">\n  <div class=\"poignee\"></div>\n  <span class=\"eti\">Lire</span>\n  <h3 id=\"ml-t-livre\">O\u00f9 trouver <em>le livre</em></h3>\n  <div class=\"opts\">\n    <a class=\"opt\" href=\"https://www.placedeslibraires.fr/livre/9782889841141-merveilleux-abandon-recit-d-une-experience-humaine-et-universelle-armelle-de-the-zoe-le-gavrian/\" target=\"_blank\" rel=\"noopener\"><span>Chez mon libraire<small>Trouver une librairie pr\u00e8s de chez moi</small></span><span class=\"f\">\u2192</span></a>\n    <a class=\"opt\" href=\"https://www.laprocure.com/product/2174882/Merveilleux%20abandon\" target=\"_blank\" rel=\"noopener\"><span>La Procure</span><span class=\"f\">\u2192</span></a>\n    <a class=\"opt\" href=\"https://bit.ly/43sooAy\" target=\"_blank\" rel=\"noopener\"><span>Acheter en ligne</span><span class=\"f\">\u2192</span></a>\n    <a class=\"opt\" href=\"/le-livre/\"><span>D\u00e9couvrir le livre<small>Le r\u00e9sum\u00e9, les illustrations de Zo\u00e9</small></span><span class=\"f\">\u2192</span></a>\n  </div>\n  <button class=\"fermer\" type=\"button\">Fermer</button>\n</section>\n<section class=\"feuille\" id=\"ml-contact\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ml-t-contact\">\n  <div class=\"poignee\"></div>\n  <span class=\"eti\">\u00c9crire</span>\n  <h3 id=\"ml-t-contact\">Me <em>contacter</em></h3>\n  <p>Presse, conf\u00e9rence, ou simplement me raconter votre histoire.</p>\n  <div class=\"opts\">\n    <a class=\"opt\" href=\"mailto:armelledethe@merveilleuxabandon.fr\"><span>armelledethe@merveilleuxabandon.fr<small>\u00c9crire un email</small></span><span class=\"f\">\u2192</span></a>\n    <a class=\"opt\" href=\"/contact/\"><span>Formulaire de contact</span><span class=\"f\">\u2192</span></a>\n    <a class=\"opt\" href=\"https://www.instagram.com/armelledethe/\" target=\"_blank\" rel=\"noopener\"><span>Message sur Instagram</span><span class=\"f\">\u2192</span></a>\n  </div>\n  <button class=\"fermer\" type=\"button\">Fermer</button>\n</section>\n</div>\n<script>\n(function(){var r=document.querySelector('.ma-liens');if(!r)return;var v=document.getElementById('ml-voile'),o=null;\nfunction ouvrir(id){o=document.getElementById(id);o.classList.add('ouvert');v.classList.add('ouvert');}\nfunction fermer(){if(o)o.classList.remove('ouvert');v.classList.remove('ouvert');o=null;}\nr.querySelectorAll('[data-feuille]').forEach(function(b){b.addEventListener('click',function(){ouvrir(b.dataset.feuille)})});\nr.querySelectorAll('.fermer').forEach(function(b){b.addEventListener('click',fermer)});\nv.addEventListener('click',fermer);document.addEventListener('keydown',function(e){if(e.key==='Escape')fermer()});\nvar f=r.querySelector('#ml-form form');if(f){f.addEventListener('submit',function(){setTimeout(function(){f.hidden=true;document.getElementById('ml-merci').hidden=false;},400)});}\n})();\n</script>\n<!-- /wp:html -->"