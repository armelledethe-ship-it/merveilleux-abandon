{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "blanc",
					"name": "Blanc",
					"color": "#FFFFFF"
				},
				{
					"slug": "creme",
					"name": "Crème",
					"color": "#F7F4F0"
				},
				{
					"slug": "nuit",
					"name": "Bleu nuit",
					"color": "#172A46"
				},
				{
					"slug": "nuit-profond",
					"name": "Bleu nuit profond",
					"color": "#0F1C30"
				},
				{
					"slug": "ardoise",
					"name": "Ardoise",
					"color": "#4A5A75"
				},
				{
					"slug": "corail",
					"name": "Corail",
					"color": "#C9553C"
				},
				{
					"slug": "corail-texte",
					"name": "Corail texte",
					"color": "#B84A33"
				},
				{
					"slug": "corail-clair",
					"name": "Corail clair",
					"color": "#F2B5A4"
				},
				{
					"slug": "brume",
					"name": "Brume",
					"color": "#E9EEF5"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "titre",
					"name": "Playfair Display",
					"fontFamily": "'Playfair Display', Georgia, serif"
				},
				{
					"slug": "texte",
					"name": "DM Sans",
					"fontFamily": "'DM Sans', system-ui, sans-serif"
				},
				{
					"slug": "signature",
					"name": "Playfair Display",
					"fontFamily": "'Playfair Display', Georgia, serif"
				}
			],
			"fontSizes": [
				{
					"slug": "petit",
					"name": "Petit",
					"size": "0.875rem"
				},
				{
					"slug": "normal",
					"name": "Normal",
					"size": "1.0625rem"
				},
				{
					"slug": "grand",
					"name": "Grand",
					"size": "1.1875rem"
				},
				{
					"slug": "titre-3",
					"name": "Titre 3",
					"size": "1.375rem"
				},
				{
					"slug": "titre-2",
					"name": "Titre 2",
					"size": "clamp(1.75rem, 3.2vw, 2.4rem)"
				},
				{
					"slug": "titre-1",
					"name": "Titre 1",
					"size": "clamp(2.4rem, 5vw, 4.2rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%"
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--blanc)",
			"text": "var(--wp--preset--color--nuit)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--texte)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.85",
			"fontWeight": "300"
		},
		"spacing": {
			"padding": {
				"left": "24px",
				"right": "24px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--nuit)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--corail-texte)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titre)",
					"fontWeight": "300",
					"lineHeight": "1.08",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titre-1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titre-2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--titre-3)",
					"fontWeight": "400",
					"lineHeight": "1.25"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--corail)",
					"text": "var(--wp--preset--color--blanc)"
				},
				"typography": {
					"fontWeight": "500",
					"fontSize": "0.9375rem",
					"letterSpacing": "0.02em"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "28px",
						"right": "28px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--corail-texte)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titre)",
					"fontSize": "1.5rem",
					"fontWeight": "400"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "400",
					"letterSpacing": "0.02em"
				}
			},
			"core/quote": {
				"border": {
					"width": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--nuit)",
					"text": "#F7F2EA"
				},
				"spacing": {
					"padding": {
						"top": "48px",
						"bottom": "48px",
						"left": "56px",
						"right": "56px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titre)",
					"fontSize": "1.375rem",
					"fontStyle": "italic",
					"fontWeight": "300",
					"lineHeight": "1.6"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "En-tête",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pied de page",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-pleine-largeur",
			"title": "Page pleine largeur",
			"postTypes": [
				"page"
			]
		}
	]
}